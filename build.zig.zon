// Package manifest for mzValidate.
// Do not run `zig fetch .` from this repo: Zig copies the whole working tree
// into ./zig-pkg/.tmp-* before applying `.paths` below, which recursively
// nests zig-pkg/ and tmp/ and can consume tens of GB. Builds fetch the zmz
// dependency into ./zig-pkg/ (gitignored). To hash this package, copy only
// the `.paths` entries into a clean temp directory and fetch from there.
.{
    .name = .mzvalidate,
    .version = "0.1.10",
    .fingerprint = 0x852e43c03f8a10d3,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .zmz = .{
            .url = "git+https://github.com/eneskemalergin/zmz?ref=v0.1.0#1a0537c0523d7fcf0a607e762d52c23939afd887",
            .hash = "zmz-0.1.0-3Lt177plJACM60Yx_zZCmIxHqE7E-Yvqfcnyxlait5fG",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "fixtures",
        "LICENSE",
        "README.md",
        "src",
    },
}
