# Build the context block.
# Args: fixture, fixture_path, file_size_bytes, zebrac_flags, mzvalidate_path,
#       config_order_csv
build_context_json() {
    local fixture="$1"
    local fixture_path="$2"
    local file_size="$3"
    local zebrac_flags="$4"
    local mzvalidate_path="$5"
    local config_order_csv="$6"

    local timestamp hostname cpu_model cpu_cores ram_mib kernel governor freq
    local git_rev git_branch git_dirty zebrac_ver

    timestamp=$(timestamp_iso)
    hostname=$(get_hostname)
    cpu_model=$(get_cpu_model)
    cpu_cores=$(get_cpu_cores)
    ram_mib=$(get_ram_mib)
    kernel=$(get_kernel)
    governor=$(get_cpu_governor)
    freq=$(get_cpu_freq)
    git_rev=$(get_git_rev)
    git_branch=$(get_git_branch)
    git_dirty=$(get_git_dirty)
    zebrac_ver=$(get_zebrac_version)

    jq -n \
        --argjson schema "$SCHEMA_VERSION" \
        --argjson script "$SCRIPT_VERSION" \
        --arg timestamp "$timestamp" \
        --arg hostname "$hostname" \
        --arg cpu_model "$cpu_model" \
        --arg cpu_cores "$cpu_cores" \
        --arg ram_mib "$ram_mib" \
        --arg kernel "$kernel" \
        --arg governor "$governor" \
        --arg freq "$freq" \
        --arg git_rev "$git_rev" \
        --arg git_branch "$git_branch" \
        --arg git_dirty "$git_dirty" \
        --arg zebrac_ver "$zebrac_ver" \
        --arg fixture "$fixture" \
        --arg fixture_path "$fixture_path" \
        --argjson file_size "$file_size" \
        --arg zebrac_flags "$zebrac_flags" \
        --arg mzvalidate_path "$mzvalidate_path" \
        --arg config_order "$config_order_csv" \
        '{
            schema_version:    $schema,
            script_version:    $script,
            timestamp:         $timestamp,
            hostname:          $hostname,
            cpu_model:         $cpu_model,
            cpu_cores:         ($cpu_cores | tonumber),
            ram_mib:           ($ram_mib | tonumber),
            kernel:            $kernel,
            cpu_governor:      $governor,
            cpu_freq_range:    $freq,
            git_rev:           $git_rev,
            git_branch:        $git_branch,
            git_dirty:         ($git_dirty == "true"),
            zebrac_version:    $zebrac_ver,
            fixture:           $fixture,
            fixture_path:      $fixture_path,
            file_size_bytes:   $file_size,
            file_size_mib:     ($file_size / 1048576),
            zebrac_flags:      $zebrac_flags,
            mzvalidate_path:   $mzvalidate_path,
            config_order:      ($config_order | split(","))
        }'
}

# Build a per-config block with raw metrics, derived metrics, and warnings.
# Args: index, raw_json, derived_fields (11 numbers), file_size, exit_code,
#       severity_exit_code, skip_flags, config_name
# derived_fields are 11 space-separated floats from compute_derived_awk.
# Warnings are passed via stdin as one JSON array per line.
build_config_json() {
    local raw_json="$1"
    local derived_line="$2"
    local file_size="$3"
    local exit_code="$4"
    local severity_exit_code="$5"
    local skip_flags="$6"
    local config_name="$7"
    local warnings_json="$8"

    # Parse derived fields.
    read -r d_wall_ms d_wall_s d_mibs d_rss_mib d_rss_pct d_cyc_m d_ins_m \
        d_ipc d_cache_pct d_branch_pct d_cv_pct <<<"$derived_line"

    # Build the raw block from the raw_json. We pull out only the fields we
    # know about; nulls propagate through.
    local raw_block
    raw_block=$(jq '{
        wall_time:        { mean_ns: .wall_time.mean,        stddev_ns: .wall_time.std_dev,        unit: .wall_time.unit },
        peak_rss:         { mean_bytes: .peak_rss.mean,      unit: .peak_rss.unit },
        cpu_cycles:       { mean: .cpu_cycles.mean,          unit: .cpu_cycles.unit },
        instructions:     { mean: .instructions.mean,        unit: .instructions.unit },
        cache_references: { mean: .cache_references.mean,    unit: .cache_references.unit },
        cache_misses:     { mean: .cache_misses.mean,        unit: .cache_misses.unit },
        branch_misses:    { mean: .branch_misses.mean,       unit: .branch_misses.unit },
        sample_count:     .sample_count
    }' <<<"$raw_json")

    # Merge raw with derived, exit codes, and warnings.
    jq -n \
        --arg skip "$skip_flags" \
        --arg cname "$config_name" \
        --argjson exit_code "$exit_code" \
        --argjson severity "$severity_exit_code" \
        --argjson wall_ms "$d_wall_ms" \
        --argjson wall_s  "$d_wall_s" \
        --argjson mibs    "$d_mibs" \
        --argjson rss_mib "$d_rss_mib" \
        --argjson rss_pct "$d_rss_pct" \
        --argjson cyc_m   "$d_cyc_m" \
        --argjson ins_m   "$d_ins_m" \
        --argjson ipc     "$d_ipc" \
        --argjson cache_pct  "$d_cache_pct" \
        --argjson branch_pct "$d_branch_pct" \
        --argjson cv_pct  "$d_cv_pct" \
        --argjson raw     "$raw_block" \
        --argjson warnings "$warnings_json" \
        '{
            config_name:        $cname,
            skip_flags:         $skip,
            exit_code:          $exit_code,
            severity_exit_code: $severity,
            raw:                $raw,
            derived: {
                wall_time_ms:    $wall_ms,
                wall_time_s:     $wall_s,
                throughput_mib_s:$mibs,
                rss_mib:         $rss_mib,
                rss_pct_of_file: $rss_pct,
                cycles_m:        $cyc_m,
                insns_m:         $ins_m,
                ipc:             $ipc,
                cache_miss_pct:  $cache_pct,
                branch_miss_pct: $branch_pct,
                cv_pct:          $cv_pct
            },
            warnings: $warnings
        }'
}

# Build the deltas block from per-stage raw inputs.
# Args: struct_wall_ms, struct_rss_mib, struct_cyc_m, struct_ins_m, struct_mib_s,
#       stage_wall_ms, stage_rss_mib, stage_cyc_m, stage_ins_m, file_size
# Output: JSON object with delta and percentage fields.
build_delta_json() {
    local bwm="$1" brm="$2" bcm="$3" bim="$4" bmib="$5"
    local wm="$6" rm="$7" cm="$8" im="$9" fs="${10}"

    local line
    line=$(compute_delta_awk "$bwm" "$brm" "$bcm" "$bim" "$bmib" \
        "$wm" "$rm" "$cm" "$im" "$fs")
    read -r d_wm d_mib d_rp d_rm d_cm d_im <<<"$line"

    jq -n \
        --argjson d_wall_ms "$d_wm" \
        --argjson d_mib     "$d_mib" \
        --argjson d_rss_pct "$d_rp" \
        --argjson d_rss_mib "$d_rm" \
        --argjson d_cyc_m   "$d_cm" \
        --argjson d_ins_m   "$d_im" \
        --argjson pct_wall_of_total "$(awk -v wm="$wm" -v bwm="$bwm" 'BEGIN{ if(bwm>0) print (wm-bwm)/bwm*100; else print 0}')" \
        '{
            wall_time_ms: { delta: $d_wall_ms },
            throughput_mib_s: { delta: $d_mib },
            rss_pct_of_file: { delta: $d_rss_pct },
            rss_mib: { delta: $d_rss_mib },
            cycles_m: { delta: $d_cyc_m },
            insns_m: { delta: $d_ins_m },
            pct_of_struct_wall: $pct_wall_of_total
        }'
}

# Build the breakdown block (% of total wall and RSS).
# Args: struct_wall_ms, idx_wall_ms, bin_wall_ms, sem_wall_ms, full_wall_ms,
#       struct_rss_mib, idx_rss_mib, bin_rss_mib, sem_rss_mib, full_rss_mib
build_breakdown_json() {
    local swm="$1" iwm="$2" bwm="$3" ewm="$4" fwm="$5"
    local srm="$6" irm="$7" brm="$8" erm="$9" frm="${10}"

    awk -v swm="$swm" -v iwm="$iwm" -v bwm="$bwm" -v ewm="$ewm" -v fwm="$fwm" \
         -v srm="$srm" -v irm="$irm" -v brm="$brm" -v erm="$erm" -v frm="$frm" '
    BEGIN {
        # Stage deltas vs struct can be negative when the OS page cache
        # warms between runs or when a stage reuses work that the struct
        # stage had to do. Clamp at 0 for "% of full" reporting since
        # negative stage cost is physically meaningless, but keep the raw
        # values visible in deltas for transparency.
        s_pct = (fwm > 0) ? swm / fwm * 100 : 0
        i_pct = (fwm > 0 && (iwm - swm) > 0) ? (iwm - swm) / fwm * 100 : 0
        b_pct = (fwm > 0 && (bwm - swm) > 0) ? (bwm - swm) / fwm * 100 : 0
        e_pct = (fwm > 0 && (ewm - swm) > 0) ? (ewm - swm) / fwm * 100 : 0
        s_rss = (frm > 0) ? srm / frm * 100 : 0
        i_rss = (frm > 0 && (irm - srm) > 0) ? (irm - srm) / frm * 100 : 0
        b_rss = (frm > 0 && (brm - srm) > 0) ? (brm - srm) / frm * 100 : 0
        e_rss = (frm > 0 && (erm - srm) > 0) ? (erm - srm) / frm * 100 : 0
        printf "%.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f\n", \
            s_pct, i_pct, b_pct, e_pct, \
            s_rss, i_rss, b_rss, e_rss
    }' | jq -R 'split(" ") | map(tonumber) |
        {
            wall_time_pct: {
                struct:   .[0], index: .[1], binary: .[2], semantic: .[3]
            },
            rss_pct: {
                struct:   .[4], index: .[5], binary: .[6], semantic: .[7]
            }
        }'
}

# ---------------------------------------------------------------------------
# Terminal rendering
# ---------------------------------------------------------------------------

# Render a fixed-width table from headers and data rows.
# Args: list of header names, then newline-separated rows of pipe-delimited
# cells. Each row is one config.
render_table() {
    local -a headers=("$@")
    shift ${#headers[@]}

    local -a rows=()
    while IFS= read -r line; do
        [[ -n "$line" ]] && rows+=("$line")
    done

    # Compute column widths. Headers are column 0.
    local n_cols=${#headers[@]}
    local -a widths
    for ((c = 0; c < n_cols; c++)); do
        widths[$c]=${#headers[$c]}
    done

    for row in "${rows[@]}"; do
        IFS='|' read -ra cells <<<"$row"
        for ((c = 0; c < n_cols; c++)); do
            local len=${#cells[$c]}
            if (( len > widths[c] )); then
                widths[$c]=$len
            fi
        done
    done

    # Header
    local line=""
    for ((c = 0; c < n_cols; c++)); do
        if (( c == 0 )); then
            line+=$(printf "%-${widths[$c]}s" "${headers[$c]}")
        else
            line+=$(printf " %${widths[$c]}s" "${headers[$c]}")
        fi
    done
    echo "$line"

    # Separator
    line=""
    for ((c = 0; c < n_cols; c++)); do
        local sep
        sep=$(printf "%${widths[$c]}s" "" | tr ' ' '-')
        if (( c == 0 )); then
            line+="$sep"
        else
            line+=" $sep"
        fi
    done
    echo "$line"

    # Data
    for row in "${rows[@]}"; do
        IFS='|' read -ra cells <<<"$row"
        line=""
        for ((c = 0; c < n_cols; c++)); do
            if (( c == 0 )); then
                line+=$(printf "%-${widths[$c]}s" "${cells[$c]:-}")
            else
                line+=$(printf " %${widths[$c]}s" "${cells[$c]:-}")
            fi
        done
        echo "$line"
    done
}

# Render the profile summary table from prepared data.
# Args: rows_newline (one row per config, pipe-delimited columns)
render_profile_table() {
    local rows="$1"

    echo ""
    render_table \
        "Stage" "wall_ms" "wall_s" "MiB/s" "RSS_MiB" "RSS_%" \
        "cycles_M" "insns_M" "IPC" "cache%" "branch%" "CV%" \
        <<<"$rows"
}

# Render compare table. Args: rows_newline.
render_compare_table() {
    local rows="$1"

    echo ""
    render_table \
        "Stage" "old" "new" "delta" "change%" "p" "d" \
        <<<"$rows"
}

# ---------------------------------------------------------------------------
# Gate evaluation
# ---------------------------------------------------------------------------

# Evaluate a single gate against a derived value.
# Args: actual, op (min|max), threshold
# Output: "pass" or "fail"
eval_gate() {
    local actual="$1" op="$2" threshold="$3"
    case "$op" in
        min)
            if float_gt "$actual" "$threshold"; then
                echo "pass"
            else
                echo "fail"
            fi
            ;;
        max)
            if float_gt "$threshold" "$actual"; then
                echo "pass"
            else
                echo "fail"
            fi
            ;;
        *)
            die "unknown gate op: $op (use 'min' or 'max')"
            ;;
    esac
}

# Evaluate all gates against a configs object. Outputs a JSON array.
# Args: gates_file, configs_json_object
evaluate_gates() {
    local gates_file="$1"
    local configs_json="$2"

    local gates_data
    gates_data=$(cat "$gates_file")

    jq -n --argjson gates "$gates_data" --argjson configs "$configs_json" '
        [
            $gates[] |
            . as $gate |
            ($configs[$gate.config].derived[$gate.metric]) as $actual |
            {
                label:  ($gate.label // ($gate.config + ":" + $gate.metric)),
                config: $gate.config,
                metric: $gate.metric,
                op:     $gate.op,
                threshold: $gate.value,
                actual: $actual,
                status: (
                    if $gate.op == "min" then
                        (if $actual >= $gate.value then "pass" else "fail" end)
                    elif $gate.op == "max" then
                        (if $actual <= $gate.value then "pass" else "fail" end)
                    else "invalid_op"
                    end
                )
            }
        ]
        '
}

# ---------------------------------------------------------------------------
# Profile mode
# ---------------------------------------------------------------------------

run_profile() {
    mkdir -p "$PROFILING_DIR"

    local -a fixtures=("${FIXTURES[@]}")
    local gate_failed=0

    for fixture in "${fixtures[@]}"; do
        local out_dir="$PROFILING_DIR"
        if [[ -n "$JSON_DIR" ]]; then
            local base
            base=$(basename "$fixture")
            out_dir="$JSON_DIR/${base%.mzML}"
            mkdir -p "$out_dir"
        fi

        if [[ ${#fixtures[@]} -gt 1 ]]; then
            echo ""
            echo "============================================================"
            echo "Fixture: $fixture"
            echo "============================================================"
        fi

        if ! run_profile_single "$fixture" "$out_dir"; then
            gate_failed=1
        fi
    done

    if [[ -n "$JSON_DIR" && ${#fixtures[@]} -gt 1 ]]; then
        write_suite_manifest "$JSON_DIR"
    fi

    if [[ "$gate_failed" -eq 1 ]]; then
        exit 3
    fi
}

# Run profile for a single fixture. Outputs to terminal and (optionally) to
# $out_dir/baseline.json. Returns 1 if any gate failed, 0 otherwise.
run_profile_single() {
    local fixture="$1"
    local out_dir="$2"

    local file_size
    file_size=$(stat -c%s "$fixture" 2>/dev/null || stat -f%z "$fixture" 2>/dev/null)
    local fixture_name
    fixture_name=$(basename "$fixture")

    echo ""
    echo "Fixture: $fixture_name ($(format_dec "$(calc "$file_size / 1048576.0")" 1) MiB)"

    # Determine execution order. JSON emission uses canonical order
    # (CONFIG_KEYS); only the order zebrac is invoked changes.
    local exec_order
    if [[ "$RANDOMIZE" -eq 1 ]]; then
        exec_order=$(shuffle_configs | paste -sd, -)
    else
        exec_order=$(IFS=,; echo "${CONFIG_KEYS[*]}")
    fi
    IFS=, read -ra exec_keys <<<"$exec_order"
    info "execution order: $exec_order"

    # Build an associative array from config key -> index in CONFIG_KEYS.
    declare -A key_to_idx
    for i in "${!CONFIG_KEYS[@]}"; do
        key_to_idx[${CONFIG_KEYS[$i]}]=$i
    done

    # Arrays indexed by canonical index (0..4), populated as we run.
    local -a raw_jsons=()
    local -a derived_lines=()
    local -a exit_codes=()
    local -a severity_codes=()
    local -a warnings_per_config=()

    # First pass: capture exit codes (clean/warnings/errors) per config.
    for i in "${!exec_keys[@]}"; do
        local key="${exec_keys[$i]}"
        local idx="${key_to_idx[$key]}"
        local flags="${CONFIG_SKIP_FLAGS[$idx]}"
        local rc=0
        "$MZVALIDATE" check "$fixture" -summary $flags >/dev/null 2>&1 || rc=$?
        severity_codes[$idx]=$rc
        if [[ $rc -eq 2 ]]; then
            exit_codes[$idx]=2
        else
            exit_codes[$idx]=0
        fi
    done

    # Second pass: run zebrac for each config. Stale JSON files are removed
    # so a missing field cannot be masked by a leftover value.
    for i in "${!exec_keys[@]}"; do
        local key="${exec_keys[$i]}"
        local idx="${key_to_idx[$key]}"
        local flags="${CONFIG_SKIP_FLAGS[$idx]}"
        local json_file="$PROFILING_DIR/${key}.json"

        rm -f "$json_file"

        drop_caches

        if [[ $VERBOSE -eq 1 ]]; then
            echo "Running $key..." >&2
        else
            printf "Running %-5s ... " "$key" >&2
        fi

        if ! timeout "$TIMEOUT_SECONDS" "$ZEBRAC" -f "${ZEBRAC_FLAGS[@]}" \
                --json "$json_file" \
                "$MZVALIDATE check $fixture -summary $flags" \
                >/dev/null 2>&1; then
            local rc=$?
            if [[ $rc -eq 124 ]]; then
                echo "" >&2
                die "$key timed out after $TIMEOUT_SECONDS seconds" 2
            else
                echo "" >&2
                die "zebrac failed for $key (exit $rc)" 2
            fi
        fi

        echo "done" >&2

        # Verify zebrac wrote a valid JSON file. If the file is missing
        # or empty, the config failed silently (zebrac -f permits non-zero
        # exit from the benchmarked command, but doesn't guarantee output).
        if [[ ! -f "$json_file" || ! -s "$json_file" ]]; then
            die "$key produced no zebrac output; check the command and retry" 2
        fi

        # Extract raw metrics. Failure here is non-fatal: we still record
        # a "missing" block so downstream tools see the gap.
        local raw missing_list=()
        raw=$(extract_all_metrics "$json_file" 2>/dev/null) || raw='{}'

        # Identify missing fields. Each is reported as a warning.
        for field in wall_time peak_rss cpu_cycles instructions \
                     cache_references cache_misses branch_misses; do
            if [[ "$(jq -r --arg f "$field" '.[$f] // "null"' <<<"$raw")" == "null" ]]; then
                missing_list+=("missing_metric:$field")
                warn "$key: missing zebrac field '$field'"
            fi
        done

        # Read the values we need for derived computation. Use 0 on missing
        # so the rest of the math still runs.
        local wall_ns wall_stddev rss_bytes cycles insns cache_ref cache_miss branch_miss
        wall_ns=$(jq -r '.wall_time.mean        // 0' <<<"$raw")
        wall_stddev=$(jq -r '.wall_time.std_dev   // 0' <<<"$raw")
        rss_bytes=$(jq -r '.peak_rss.mean         // 0' <<<"$raw")
        cycles=$(jq -r '.cpu_cycles.mean         // 0' <<<"$raw")
        insns=$(jq -r '.instructions.mean        // 0' <<<"$raw")
        cache_ref=$(jq -r '.cache_references.mean  // 0' <<<"$raw")
        cache_miss=$(jq -r '.cache_misses.mean      // 0' <<<"$raw")
        branch_miss=$(jq -r '.branch_misses.mean     // 0' <<<"$raw")

        # Compute derived metrics.
        local derived_line
        derived_line=$(compute_derived_awk \
            "$wall_ns" "$wall_stddev" "$rss_bytes" "$cycles" "$insns" \
            "$cache_ref" "$cache_miss" "$branch_miss" "$file_size")

        # CV warning.
        local cv_pct
        cv_pct=$(awk '{print $11}' <<<"$derived_line")
        if float_gt "$cv_pct" "$CV_THRESHOLD"; then
            missing_list+=("high_cv:${cv_pct}%")
            warn "$key: CV ${cv_pct}% exceeds threshold ${CV_THRESHOLD}%"
        fi

        # Severity warning.
        if [[ ${exit_codes[$idx]} -ne 0 ]]; then
            missing_list+=("validation_errors")
        fi

        # Build the warnings JSON array.
        local warnings_json
        warnings_json=$(printf '%s\n' "${missing_list[@]}" | jq -R . | jq -s .)
        [[ ${#missing_list[@]} -eq 0 ]] && warnings_json='[]'

        # Store in canonical-indexed arrays.
        raw_jsons[$idx]=$raw
        derived_lines[$idx]=$derived_line
        exit_codes[$idx]=${exit_codes[$idx]}
        severity_codes[$idx]=${severity_codes[$idx]}
        warnings_per_config[$idx]=$warnings_json
    done

    # Build per-config JSON blocks.
    local -a config_json_arr=()
    for i in "${!CONFIG_KEYS[@]}"; do
        local key="${CONFIG_KEYS[$i]}"
        local name="${CONFIG_NAMES[$i]}"
        local flags="${CONFIG_SKIP_FLAGS[$i]}"
        local cj
        cj=$(build_config_json \
            "${raw_jsons[$i]}" \
            "${derived_lines[$i]}" \
            "$file_size" \
            "${exit_codes[$i]}" \
            "${severity_codes[$i]}" \
            "$flags" \
            "$name" \
            "${warnings_per_config[$i]}")
        config_json_arr[$i]=$cj
    done

    # Assemble configs object: { "min": {...}, "idx": {...}, ... }
    local configs_obj="{"
    for i in "${!CONFIG_KEYS[@]}"; do
        local key="${CONFIG_KEYS[$i]}"
        if [[ $i -gt 0 ]]; then configs_obj+=","; fi
        configs_obj+="\"$key\":${config_json_arr[$i]}"
    done
    configs_obj+="}"

    # Compute deltas (index, binary, semantic vs struct).
    local struct_idx=0  # canonical index of "min"
    local idx_idx=1
    local bin_idx=2
    local sem_idx=3

    # Read derived values for the four baselines we need.
    local s_wall_ms s_rss_mib s_cyc_m s_ins_m s_mibs
    s_wall_ms=$(awk '{print $1}' <<<"${derived_lines[$struct_idx]}")
    s_rss_mib=$(awk '{print $4}' <<<"${derived_lines[$struct_idx]}")
    s_cyc_m=$(awk '{print $6}' <<<"${derived_lines[$struct_idx]}")
    s_ins_m=$(awk '{print $7}' <<<"${derived_lines[$struct_idx]}")
    s_mibs=$(awk '{print $3}' <<<"${derived_lines[$struct_idx]}")

    local delta_idx delta_bin delta_sem
    delta_idx=$(build_delta_json "$s_wall_ms" "$s_rss_mib" "$s_cyc_m" "$s_ins_m" "$s_mibs" \
        "$(awk '{print $1}' <<<"${derived_lines[$idx_idx]}")" \
        "$(awk '{print $4}' <<<"${derived_lines[$idx_idx]}")" \
        "$(awk '{print $6}' <<<"${derived_lines[$idx_idx]}")" \
        "$(awk '{print $7}' <<<"${derived_lines[$idx_idx]}")" \
        "$file_size")
    delta_bin=$(build_delta_json "$s_wall_ms" "$s_rss_mib" "$s_cyc_m" "$s_ins_m" "$s_mibs" \
        "$(awk '{print $1}' <<<"${derived_lines[$bin_idx]}")" \
        "$(awk '{print $4}' <<<"${derived_lines[$bin_idx]}")" \
        "$(awk '{print $6}' <<<"${derived_lines[$bin_idx]}")" \
        "$(awk '{print $7}' <<<"${derived_lines[$bin_idx]}")" \
        "$file_size")
    delta_sem=$(build_delta_json "$s_wall_ms" "$s_rss_mib" "$s_cyc_m" "$s_ins_m" "$s_mibs" \
        "$(awk '{print $1}' <<<"${derived_lines[$sem_idx]}")" \
        "$(awk '{print $4}' <<<"${derived_lines[$sem_idx]}")" \
        "$(awk '{print $6}' <<<"${derived_lines[$sem_idx]}")" \
        "$(awk '{print $7}' <<<"${derived_lines[$sem_idx]}")" \
        "$file_size")

    local deltas_obj
    deltas_obj=$(jq -n \
        --argjson idx "$delta_idx" \
        --argjson bin "$delta_bin" \
        --argjson sem "$delta_sem" \
        '{
            index_vs_struct:    $idx,
            binary_vs_struct:   $bin,
            semantic_vs_struct: $sem
        }')

    # Compute breakdown.
    local f_wall_ms=$(awk '{print $1}' <<<"${derived_lines[4]}")
    local f_rss_mib=$(awk '{print $4}' <<<"${derived_lines[4]}")
    local breakdown_obj
    breakdown_obj=$(build_breakdown_json \
        "$s_wall_ms" \
        "$(awk '{print $1}' <<<"${derived_lines[$idx_idx]}")" \
        "$(awk '{print $1}' <<<"${derived_lines[$bin_idx]}")" \
        "$(awk '{print $1}' <<<"${derived_lines[$sem_idx]}")" \
        "$f_wall_ms" \
        "$s_rss_mib" \
        "$(awk '{print $4}' <<<"${derived_lines[$idx_idx]}")" \
        "$(awk '{print $4}' <<<"${derived_lines[$bin_idx]}")" \
        "$(awk '{print $4}' <<<"${derived_lines[$sem_idx]}")" \
        "$f_rss_mib")

    # Build context.
    local zebrac_flags_str
    zebrac_flags_str=$(printf '%s ' "${ZEBRAC_FLAGS[@]+"${ZEBRAC_FLAGS[@]}"}" | sed 's/[[:space:]]*$//')
    local context_obj
    context_obj=$(build_context_json \
        "$fixture_name" \
        "$fixture" \
        "$file_size" \
        "$zebrac_flags_str" \
        "$MZVALIDATE" \
        "$(IFS=,; echo "${CONFIG_KEYS[*]}")")

    # Evaluate gates if requested.
    local gates_json="[]"
    local any_gate_failed=0
    if [[ -n "$GATES_FILE" ]]; then
        # Validate gates file first to give a clear error if it's malformed.
        if ! jq empty "$GATES_FILE" 2>/dev/null; then
            die "gates file is not valid JSON: $GATES_FILE"
        fi
        # Validate configs_obj too.
        if ! echo "$configs_obj" | jq empty 2>/dev/null; then
            die "configs_obj is not valid JSON (length: ${#configs_obj})"
        fi
        local eval_out eval_rc
        eval_out=$(evaluate_gates "$GATES_FILE" "$configs_obj" 2>/tmp/gates-err.$$)
        eval_rc=$?
        if [[ $eval_rc -ne 0 ]]; then
            warn "evaluate_gates failed (rc=$eval_rc)"
            [[ -s /tmp/gates-err.$$ ]] && cat /tmp/gates-err.$$ >&2
            rm -f /tmp/gates-err.$$
            gates_json='[]'
        else
            gates_json="$eval_out"
        fi
        rm -f /tmp/gates-err.$$
        # Detect failures for exit code purposes.
        local fail_count
        fail_count=$(jq '[.[] | select(.status == "fail")] | length' <<<"$gates_json")
        if [[ "$fail_count" -gt 0 ]]; then
            any_gate_failed=1
        fi
    fi

    # Assemble final JSON.
    local final_json
    final_json=$(jq -n \
        --argjson schema "$SCHEMA_VERSION" \
        --argjson script "$SCRIPT_VERSION" \
        --argjson context "$context_obj" \
        --argjson configs "$configs_obj" \
        --argjson deltas "$deltas_obj" \
        --argjson breakdown "$breakdown_obj" \
        --argjson gates "$gates_json" \
        '{
            schema_version: $schema,
            script_version: $script,
            context: $context,
            configs: $configs,
            deltas: $deltas,
            breakdown: $breakdown,
            gates: $gates
        }')

    # Render the terminal table.
    local rows=""
    for i in "${!CONFIG_KEYS[@]}"; do
        local key="${CONFIG_KEYS[$i]}"
        local name="${CONFIG_NAMES[$i]}"
        local line="${derived_lines[$i]}"
        read -r w_ms w_s mibs r_mib r_pct c_m i_m ipc c_pct b_pct cv <<<"$line"
        local marker=""
        if [[ ${exit_codes[$i]} -ne 0 ]]; then marker="*"; fi
        rows+="${name}${marker}|$(format_dec "$w_ms" 1)|$(format_dec "$w_s" 3)|$(format_dec "$mibs" 1)|$(format_dec "$r_mib" 1)|$(format_dec "$r_pct" 1)|$(format_dec "$c_m" 1)|$(format_dec "$i_m" 1)|$(format_dec "$ipc" 2)|$(format_dec "$c_pct" 1)|$(format_dec "$b_pct" 2)|$(format_dec "$cv" 1)"$'\n'
    done
    render_profile_table "$rows"

    # Stage delta summary.
    echo ""
    echo "Stage deltas (each stage vs struct baseline):"
    local delta_rows=""
    for label in "Index|index_vs_struct" "Binary|binary_vs_struct" "Semantic|semantic_vs_struct"; do
        local name="${label%|*}"
        local key="${label#*|}"
        local d_wall_ms d_rss_mib d_pct
        d_wall_ms=$(jq -r ".${key}.wall_time_ms.delta" <<<"$deltas_obj")
        d_rss_mib=$(jq -r ".${key}.rss_mib.delta" <<<"$deltas_obj")
        d_pct=$(jq -r ".${key}.pct_of_struct_wall" <<<"$deltas_obj")
        delta_rows+="$name|$(format_dec "$d_wall_ms" 1)|$(format_dec "$d_rss_mib" 1)|$(format_dec "$d_pct" 1)"$'\n'
    done
    render_table "Stage" "d_wall_ms" "d_rss_mib" "d_pct_of_struct" <<<"$delta_rows"

    # Breakdown.
    echo ""
    echo "Breakdown (% of full):"
    local breakdown_rows=""
    for stage_key in struct index binary semantic; do
        local wpct rpct
        wpct=$(jq -r ".wall_time_pct.$stage_key" <<<"$breakdown_obj")
        rpct=$(jq -r ".rss_pct.$stage_key"       <<<"$breakdown_obj")
        local pretty
        case "$stage_key" in
            struct)   pretty="Struct" ;;
            index)    pretty="Index" ;;
            binary)   pretty="Binary" ;;
            semantic) pretty="Semantic" ;;
        esac
        breakdown_rows+="$pretty|$(format_dec "$wpct" 1)|$(format_dec "$rpct" 1)"$'\n'
    done
    render_table "Stage" "wall%" "rss%" <<<"$breakdown_rows"

    # Gate summary.
    if [[ -n "$GATES_FILE" ]]; then
        echo ""
        echo "Gates:"
        local g_rows=""
        while IFS= read -r gate; do
            local label actual status op threshold
            label=$(jq -r '.label' <<<"$gate")
            actual=$(jq -r '.actual' <<<"$gate")
            status=$(jq -r '.status' <<<"$gate")
            op=$(jq -r '.op' <<<"$gate")
            threshold=$(jq -r '.threshold' <<<"$gate")
            g_rows+="$label|$(format_dec "$actual" 2)|$op|$(format_dec "$threshold" 2)|$status"$'\n'
        done < <(jq -c '.[]' <<<"$gates_json")
        render_table "Gate" "actual" "op" "threshold" "status" <<<"$g_rows"
    fi

    # Validation error note.
    local has_errors=0
    for ec in "${exit_codes[@]}"; do
        if [[ "$ec" -ne 0 ]]; then has_errors=1; break; fi
    done
    if [[ $has_errors -eq 1 ]]; then
        echo ""
        echo "* = validation errors (non-zero exit). Warnings are advisory."
    fi

    # Write JSON.
    if [[ -n "$out_dir" ]]; then
        local out_file="$out_dir/baseline.json"
        # Pretty-print for human readability.
        echo "$final_json" | jq '.' > "$out_file"
        echo ""
        echo "JSON saved to: $out_file"
    fi

    if [[ $any_gate_failed -eq 1 ]]; then
        return 1
    fi
    return 0
}

# Build a manifest.json that aggregates per-fixture results in suite mode.
write_suite_manifest() {
    local json_dir="$1"

    local -a fixtures=()
    for f in "$json_dir"/*/baseline.json; do
        [[ -f "$f" ]] || continue
        fixtures+=("$f")
    done

    if [[ ${#fixtures[@]} -eq 0 ]]; then
        warn "no per-fixture baseline.json found in $json_dir"
        return
    fi

    local files_json
    files_json=$(printf '%s\n' "${fixtures[@]}" | jq -R . | jq -s .)

    local manifest
    manifest=$(jq -n \
        --argjson schema "$SCHEMA_VERSION" \
        --argjson script "$SCRIPT_VERSION" \
        --argjson files "$files_json" \
        --argjson count "${#fixtures[@]}" \
        '{
            schema_version: $schema,
            script_version: $script,
            mode: "suite",
            fixture_count: $count,
            generated_at: (now | todate),
            files: $files
        }')

    echo "$manifest" | jq '.' > "$json_dir/manifest.json"
    echo ""
    echo "Suite manifest saved to: $json_dir/manifest.json"
}

# ---------------------------------------------------------------------------
# Compare mode
# ---------------------------------------------------------------------------

run_compare() {
    local old_json="$1"
    local new_json="$2"

    # Detect v1 vs v2 schema. v1 used "runs"; v2 uses "configs".
    local old_schema
    old_schema=$(jq -r '.schema_version // "v1"' "$old_json")
    local new_schema
    new_schema=$(jq -r '.schema_version // "v1"' "$new_json")
    if [[ "$old_schema" == "v1" || "$new_schema" == "v1" ]]; then
        die "one of the inputs uses the v1 schema; regenerate with bench-profile v2"
    fi

    local old_fixture new_fixture old_size new_size
    old_fixture=$(jq -r '.context.fixture'  "$old_json")
    new_fixture=$(jq -r '.context.fixture'  "$new_json")
    old_size=$(jq -r    '.context.file_size_bytes' "$old_json")
    new_size=$(jq -r    '.context.file_size_bytes' "$new_json")

    if [[ "$old_fixture" != "$new_fixture" ]]; then
        warn "comparing different fixtures: '$old_fixture' vs '$new_fixture'"
    fi
    if [[ "$old_size" != "$new_size" ]]; then
        warn "different file sizes: $old_size vs $new_size bytes (some deltas may be misleading)"
    fi

    local old_rev new_rev old_branch new_branch
    old_rev=$(jq -r '.context.git_rev'    "$old_json")
    new_rev=$(jq -r '.context.git_rev'    "$new_json")
    old_branch=$(jq -r '.context.git_branch' "$old_json")
    new_branch=$(jq -r '.context.git_branch' "$new_json")

    echo ""
    echo "Comparing:"
    echo "  old: $old_json"
    echo "       $old_fixture @ ${old_branch:-?}/${old_rev:-?}"
    echo "  new: $new_json"
    echo "       $new_fixture @ ${new_branch:-?}/${new_rev:-?}"

    # Compute sample size from one config's wall_time sample_count.
    # All configs in a run share the same n.
    local n
    n=$(jq -r '.configs.min.raw.sample_count // 15' "$old_json")
    if [[ "$n" == "null" || "$n" == "0" ]]; then n=15; fi

    # Wall-time comparison.
    local wall_regressed=0
    echo ""
    echo "Wall time (ms):"
    local wall_rows=""
    for i in "${!CONFIG_KEYS[@]}"; do
        local key="${CONFIG_KEYS[$i]}"
        local name="${CONFIG_NAMES[$i]}"

        local om nm osd nsd
        om=$(jq -r ".configs[\"$key\"].raw.wall_time.mean_ns   // 0" "$old_json")
        nm=$(jq -r ".configs[\"$key\"].raw.wall_time.mean_ns   // 0" "$new_json")
        osd=$(jq -r ".configs[\"$key\"].raw.wall_time.stddev_ns // 0" "$old_json")
        nsd=$(jq -r ".configs[\"$key\"].raw.wall_time.stddev_ns // 0" "$new_json")

        # Convert to ms.
        om=$(awk -v v="$om" 'BEGIN{print v/1e6}')
        nm=$(awk -v v="$nm" 'BEGIN{print v/1e6}')
        osd=$(awk -v v="$osd" 'BEGIN{print v/1e6}')
        nsd=$(awk -v v="$nsd" 'BEGIN{print v/1e6}')

        local delta pct z p_label d mde
        delta=$(awk -v a="$om" -v b="$nm" 'BEGIN{print b-a}')
        if float_gt "$om" "0"; then
            pct=$(awk -v a="$om" -v b="$nm" 'BEGIN{printf "%.1f", (b-a)/a*100}')
        else
            pct="0.0"
        fi

        # Compute stats.
        local stats
        stats=$(compute_stats_awk "$om" "$osd" "$n" "$nm" "$nsd" "$n")
        read -r z pb d mde <<<"$stats"
        p_label=$(p_bucket_label "$pb")

        # Determine wall regression. Significance + threshold + sign.
        if float_gt "$pct" "$WALL_REGRESSION_PCT" && [[ "$pb" -ge 2 ]]; then
            wall_rows+="$name|$(format_dec "$om" 1)|$(format_dec "$nm" 1)|$(format_dec "$delta" 1)|$(format_dec "$pct" 1) ***|${p_label}|$(format_dec "$d" 2)"$'\n'
            wall_regressed=1
        else
            wall_rows+="$name|$(format_dec "$om" 1)|$(format_dec "$nm" 1)|$(format_dec "$delta" 1)|$(format_dec "$pct" 1)|${p_label}|$(format_dec "$d" 2)"$'\n'
        fi
    done
    render_compare_table "$wall_rows"

    # RSS comparison.
    local rss_regressed=0
    echo ""
    echo "Peak RSS (MiB):"
    local rss_rows=""
    for i in "${!CONFIG_KEYS[@]}"; do
        local key="${CONFIG_KEYS[$i]}"
        local name="${CONFIG_NAMES[$i]}"

        local om nm osd nsd
        om=$(jq -r ".configs[\"$key\"].raw.peak_rss.mean_bytes  // 0" "$old_json")
        nm=$(jq -r ".configs[\"$key\"].raw.peak_rss.mean_bytes  // 0" "$new_json")
        osd=$(jq -r ".configs[\"$key\"].raw.peak_rss.std_dev    // 0" "$old_json")
        nsd=$(jq -r ".configs[\"$key\"].raw.peak_rss.std_dev    // 0" "$new_json")
        # peak_rss typically has zero stddev (single peak measurement).
        # Use a 0.1%-of-mean floor so the statistical ratio remains
        # meaningful (z-score = (m2-m1)/se stays finite) and scales
        # with the data size instead of a hardcoded 1 byte.
        if awk -v v="$osd" 'BEGIN{exit !(v+0 == 0)}'; then osd=$(awk -v v="$om" 'BEGIN{print (v>0) ? v/1000 : 0}'); fi
        if awk -v v="$nsd" 'BEGIN{exit !(v+0 == 0)}'; then nsd=$(awk -v v="$nm" 'BEGIN{print (v>0) ? v/1000 : 0}'); fi

        om=$(awk -v v="$om" 'BEGIN{print v/1048576}')
        nm=$(awk -v v="$nm" 'BEGIN{print v/1048576}')
        osd=$(awk -v v="$osd" 'BEGIN{print v/1048576}')
        nsd=$(awk -v v="$nsd" 'BEGIN{print v/1048576}')

        local delta pct stats z pb d mde p_label
        delta=$(awk -v a="$om" -v b="$nm" 'BEGIN{print b-a}')
        if float_gt "$om" "0"; then
            pct=$(awk -v a="$om" -v b="$nm" 'BEGIN{printf "%.1f", (b-a)/a*100}')
        else
            pct="0.0"
        fi

        stats=$(compute_stats_awk "$om" "$osd" "$n" "$nm" "$nsd" "$n")
        read -r z pb d mde <<<"$stats"
        p_label=$(p_bucket_label "$pb")

        if float_gt "$pct" "$RSS_REGRESSION_PCT" && [[ "$pb" -ge 2 ]]; then
            rss_rows+="$name|$(format_dec "$om" 1)|$(format_dec "$nm" 1)|$(format_dec "$delta" 1)|$(format_dec "$pct" 1) ***|${p_label}|$(format_dec "$d" 2)"$'\n'
            rss_regressed=1
        else
            rss_rows+="$name|$(format_dec "$om" 1)|$(format_dec "$nm" 1)|$(format_dec "$delta" 1)|$(format_dec "$pct" 1)|${p_label}|$(format_dec "$d" 2)"$'\n'
        fi
    done
    render_compare_table "$rss_rows"

    # IPC comparison (decrease is bad).
    local ipc_regressed=0
    echo ""
    echo "IPC (instructions per cycle):"
    local ipc_rows=""
    for i in "${!CONFIG_KEYS[@]}"; do
        local key="${CONFIG_KEYS[$i]}"
        local name="${CONFIG_NAMES[$i]}"

        # Reconstruct IPC from raw cycles/insns to avoid re-derivation
        # inconsistencies.
        local oc oi nc ni
        oc=$(jq -r ".configs[\"$key\"].raw.cpu_cycles.mean  // 0" "$old_json")
        oi=$(jq -r ".configs[\"$key\"].raw.instructions.mean // 0" "$old_json")
        nc=$(jq -r ".configs[\"$key\"].raw.cpu_cycles.mean  // 0" "$new_json")
        ni=$(jq -r ".configs[\"$key\"].raw.instructions.mean // 0" "$new_json")

        local om nm
        om=$(awk -v c="$oc" -v i="$oi" 'BEGIN{ if(c>0) print i/c; else print 0 }')
        nm=$(awk -v c="$nc" -v i="$ni" 'BEGIN{ if(c>0) print i/c; else print 0 }')

        # For IPC stats we need stddevs of IPC. We do not have them stored;
        # approximate from cycle stddev / cycle mean (CV of cycles is small
        # but non-zero). This is good enough for a regression flag.
        local oc_sd nc_sd
        oc_sd=$(jq -r ".configs[\"$key\"].raw.cpu_cycles.std_dev  // 0" "$old_json")
        nc_sd=$(jq -r ".configs[\"$key\"].raw.cpu_cycles.std_dev  // 0" "$new_json")
        # If we have no stddev on cycles, use 1% of mean as a floor.
        if awk -v v="$oc_sd" 'BEGIN{exit !(v+0 == 0)}'; then
            oc_sd=$(awk -v v="$oc" 'BEGIN{print v*0.01}')
        fi
        if awk -v v="$nc_sd" 'BEGIN{exit !(v+0 == 0)}'; then
            nc_sd=$(awk -v v="$nc" 'BEGIN{print v*0.01}')
        fi

        # Convert stddevs to IPC units.
        local osd nsd
        osd=$(awk -v c="$oc" -v i="$oi" -v csd="$oc_sd" 'BEGIN{ if(c>0) print i*csd/(c*c); else print 0 }')
        nsd=$(awk -v c="$nc" -v i="$ni" -v csd="$nc_sd" 'BEGIN{ if(c>0) print i*csd/(c*c); else print 0 }')

        local delta pct stats z pb d mde p_label
        delta=$(awk -v a="$om" -v b="$nm" 'BEGIN{print b-a}')
        if float_gt "$om" "0"; then
            pct=$(awk -v a="$om" -v b="$nm" 'BEGIN{printf "%.1f", (b-a)/a*100}')
        else
            pct="0.0"
        fi

        stats=$(compute_stats_awk "$om" "$osd" "$n" "$nm" "$nsd" "$n")
        read -r z pb d mde <<<"$stats"
        p_label=$(p_bucket_label "$pb")

        # IPC regression = decrease beyond threshold with significance.
        local neg_pct
        neg_pct=$(awk -v p="$pct" 'BEGIN{print -p}')
        if float_gt "$neg_pct" "$IPC_REGRESSION_PCT" && [[ "$pb" -ge 2 ]]; then
            ipc_rows+="$name|$(format_dec "$om" 2)|$(format_dec "$nm" 2)|$(format_dec "$delta" 3)|$(format_dec "$pct" 1) ***|${p_label}|$(format_dec "$d" 2)"$'\n'
            ipc_regressed=1
        else
            ipc_rows+="$name|$(format_dec "$om" 2)|$(format_dec "$nm" 2)|$(format_dec "$delta" 3)|$(format_dec "$pct" 1)|${p_label}|$(format_dec "$d" 2)"$'\n'
        fi
    done
    render_compare_table "$ipc_rows"

    # Cache miss % comparison.
    echo ""
    echo "Cache miss rate (%):"
    local cm_rows=""
    for i in "${!CONFIG_KEYS[@]}"; do
        local key="${CONFIG_KEYS[$i]}"
        local name="${CONFIG_NAMES[$i]}"

        local omr nmr ocr ncr ocm ncm
        omr=$(jq -r ".configs[\"$key\"].raw.cache_references.mean // 0" "$old_json")
        nmr=$(jq -r ".configs[\"$key\"].raw.cache_references.mean // 0" "$new_json")
        ocm=$(jq -r ".configs[\"$key\"].raw.cache_misses.mean     // 0" "$old_json")
        ncm=$(jq -r ".configs[\"$key\"].raw.cache_misses.mean     // 0" "$new_json")
        # stddevs for the ratio: approximate with cache_misses stddev if
        # present, else 1% of mean.
        local ocm_sd ncm_sd
        ocm_sd=$(jq -r ".configs[\"$key\"].raw.cache_misses.std_dev // 0" "$old_json")
        ncm_sd=$(jq -r ".configs[\"$key\"].raw.cache_misses.std_dev // 0" "$new_json")
        if awk -v v="$ocm_sd" 'BEGIN{exit !(v+0 == 0)}'; then ocm_sd=$(awk -v v="$ocm" 'BEGIN{print v*0.01}'); fi
        if awk -v v="$ncm_sd" 'BEGIN{exit !(v+0 == 0)}'; then ncm_sd=$(awk -v v="$ncm" 'BEGIN{print v*0.01}'); fi

        local om nm osd nsd delta pct stats z pb d mde p_label
        om=$(awk -v r="$omr" -v m="$ocm" 'BEGIN{ if(r>0) print m/r*100; else print 0 }')
        nm=$(awk -v r="$nmr" -v m="$ncm" 'BEGIN{ if(r>0) print m/r*100; else print 0 }')
        osd=$(awk -v r="$omr" -v msd="$ocm_sd" 'BEGIN{ if(r>0) print msd/r*100; else print 0 }')
        nsd=$(awk -v r="$nmr" -v msd="$ncm_sd" 'BEGIN{ if(r>0) print msd/r*100; else print 0 }')

        delta=$(awk -v a="$om" -v b="$nm" 'BEGIN{print b-a}')
        if float_gt "$om" "0"; then
            pct=$(awk -v a="$om" -v b="$nm" 'BEGIN{printf "%.1f", (b-a)/a*100}')
        else
            pct="0.0"
        fi

        stats=$(compute_stats_awk "$om" "$osd" "$n" "$nm" "$nsd" "$n")
        read -r z pb d mde <<<"$stats"
        p_label=$(p_bucket_label "$pb")

        cm_rows+="$name|$(format_dec "$om" 2)|$(format_dec "$nm" 2)|$(format_dec "$delta" 2)|$(format_dec "$pct" 1)|${p_label}|$(format_dec "$d" 2)"$'\n'
    done
    render_compare_table "$cm_rows"

    # Summary verdict.
    echo ""
    echo "Summary:"
    if [[ $wall_regressed -eq 1 ]]; then
        echo "  wall time: REGRESSION DETECTED (threshold ${WALL_REGRESSION_PCT}%, p<0.05)"
    else
        echo "  wall time: no regression above ${WALL_REGRESSION_PCT}%"
    fi
    if [[ $rss_regressed -eq 1 ]]; then
        echo "  peak RSS:  REGRESSION DETECTED (threshold ${RSS_REGRESSION_PCT}%, p<0.05)"
    else
        echo "  peak RSS:  no regression above ${RSS_REGRESSION_PCT}%"
    fi
    if [[ $ipc_regressed -eq 1 ]]; then
        echo "  IPC:       REGRESSION DETECTED (threshold ${IPC_REGRESSION_PCT}% drop, p<0.05)"
    else
        echo "  IPC:       no regression above ${IPC_REGRESSION_PCT}% drop"
    fi

    # p_label meanings: n.s. < 0.10 < 0.05 < 0.01 < 0.001
    if [[ $wall_regressed -eq 1 || $rss_regressed -eq 1 || $ipc_regressed -eq 1 ]]; then
        echo ""
        echo "*** = exceeds regression threshold with p<0.05"
        exit 3
    fi
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------

main() {
    parse_args "$@"
    check_prereqs

    case "$MODE" in
        profile)
            run_profile
            ;;
        compare)
            run_compare "$COMPARE_OLD" "$COMPARE_NEW"
            ;;
    esac
}

main "$@"
