#!/usr/bin/env bash
# bench-profile v2: Stage profiling for mzValidate
#
# Runs five reference configurations through zebrac, captures timing, RSS,
# and hardware counters, then emits a structured profile with derived metrics,
# per-stage deltas, breakdowns, optional gate evaluation, and statistical
# significance in compare mode.
#
# Compared to v1, this version:
#   - Saves context (timestamp, git, CPU, kernel) and derived metrics (IPC,
#     cache_miss%, throughput, CV) to JSON, not just the terminal table.
#   - Pre-computes stage deltas and %-of-total breakdown in JSON.
#   - Supports inline gate evaluation with pass/fail status.
#   - Supports randomized config order and explicit cache drop to remove the
#     systematic warm-cache bias v1 had when configs ran sequentially.
#   - Flags high CV (noisy runs) as warnings instead of silently using them.
#   - Adds CPU counters, IPC, and significance statistics to --compare.
#   - Accepts multiple fixtures (suite mode) and writes a directory of
#     per-fixture JSONs plus an aggregate manifest.
#   - Detects missing zebrac fields and emits a warning instead of silently
#     substituting zero.
#
# Usage:
#   bench-profile <fixture> [more fixtures...] [zebrac-flags...] [options]
#   bench-profile --compare <old.json> <new.json> [options]
#   bench-profile --help
#
# Examples:
#   bench-profile fixtures/mzml/valid/small.pwiz.1.1.mzML
#   bench-profile data/Gong_1.mzML -d 30000 -i 3 -a 10 -w 1
#   bench-profile data/Gong_1.mzML --json tmp/profiling/gong/baseline
#   bench-profile data/Fusion.mzML --gates fixtures/gates.json
#   bench-profile data/Astral.mzML data/Fusion.mzML --json tmp/profiling/multi
#   bench-profile --compare tmp/profiling/fusion/baseline/baseline.json \
#     tmp/profiling/fusion/after/baseline.json --regression-pct 5
#
# Dependencies: zebrac, jq, awk, git (optional, for context), /proc (Linux).
#
# Exit codes:
#   0   success
#   1   user error (missing fixture, bad flags, missing dependency)
#   2   zebrac failure (timeout, crash)
#   3   gate failure (in --gates mode or compare-mode regression threshold)

set -euo pipefail

readonly SCRIPT_VERSION=2
readonly SCHEMA_VERSION=1

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
ZEBRAC="$REPO_ROOT/tools/zebrac"
MZVALIDATE="$REPO_ROOT/zig-out/bin/mzValidate"
PROFILING_DIR="$REPO_ROOT/tmp/profiling"

# ---------------------------------------------------------------------------
# Defaults (overridden by flags)
# ---------------------------------------------------------------------------

MODE="profile"
FIXTURES=()
ZEBRAC_FLAGS=()
JSON_DIR=""
COMPARE_OLD=""
COMPARE_NEW=""
GATES_FILE=""
CV_THRESHOLD=5.0
WALL_REGRESSION_PCT=5.0
RSS_REGRESSION_PCT=10.0
IPC_REGRESSION_PCT=3.0
RANDOMIZE=1
RANDOM_SEED=""
DROP_CACHES=0
TIMEOUT_SECONDS=1800
VERBOSE=0

# Stable config order (the canonical five). Randomization permutes the
# execution order, but JSON emission always uses this canonical order so
# downstream tooling sees a stable schema.
readonly -a CONFIG_KEYS=("min" "idx" "bin" "sem" "full")
readonly -a CONFIG_NAMES=("Struct" "Index" "Binary" "Semantic" "Full")
readonly -a CONFIG_SKIP_FLAGS=(
    "-skip-binary -skip-semantic -skip-index"
    "-skip-binary -skip-semantic"
    "-skip-semantic -skip-index"
    "-skip-binary -skip-index"
    ""
)

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------

usage() {
    # Select stdout or stderr for the here-doc, then attach it to the
    # entire if-block so both branches read from the same body.
    local out_fd
    if [[ "${1:-}" == "stdout" ]]; then
        out_fd="stdout"
        # cat (default = stdout)
        cat
    else
        out_fd="stderr"
        cat >&2
    fi <<'USAGE_EOF'
bench-profile v2: Stage profiling for mzValidate

Usage:
  bench-profile [profile-options] <fixture> [more fixtures...] [zebrac-flags...]
  bench-profile --compare <old.json> <new.json> [options]
  bench-profile --help

Important: profile-options (--no-randomize, --seed, --json, --gates, etc.)
must appear BEFORE the fixture. Anything after the fixture is passed through
to zebrac. The --json and --quiet flags are consumed by bench-profile; zebrac
gets its own --json internally for capturing raw output.

Profile options:
  --json <dir>               Write per-fixture baseline.json to <dir>. When
                             multiple fixtures are given, each gets its own
                             subdirectory.
  --gates <file>             Evaluate gate thresholds from a JSON file. The
                             file is a list of {config, metric, op, value}
                             records. See README section "Gates" below.
  --cv-threshold <pct>       Warn when a config's wall-time CV exceeds this
                             percentage. Default: 5.0.
  --regression-pct <pct>     Wall-time regression threshold for --compare.
                             Default: 5.0.
  --rss-regression-pct <pct> RSS regression threshold for --compare.
                             Default: 10.0.
  --ipc-regression-pct <pct> IPC regression threshold (decrease) for
                             --compare. Default: 3.0.
  --randomize / --no-randomize
                             Shuffle config execution order to remove
                             systematic warm-cache bias. Default: randomize.
  --seed <N>                 Deterministic seed for config shuffling.
  --drop-caches              Drop the OS page cache before each config
                             (requires write access to /proc/sys/vm/drop_caches).
  --timeout <seconds>        Per-config zebrac timeout. Default: 1800.
  --quiet                    Suppress per-config progress on stderr.

Compare options:
  --compare <old> <new>      Compare two baseline.json files. Reports wall
                             and RSS deltas with statistical significance,
                             plus CPU counter, IPC, and cache-miss deltas.
  --regression-pct <pct>     Wall-time regression threshold. Default: 5.0.
  --rss-regression-pct <pct> RSS regression threshold. Default: 10.0.
  --ipc-regression-pct <pct> IPC regression threshold. Default: 3.0.

Other:
  --help, -h                 Show this help.
  --version                  Show version.

The script runs five validation configurations in randomized order by default:
  min   -skip-binary -skip-semantic -skip-index   (XML + Structural only)
  idx   -skip-binary -skip-semantic               (adds Index)
  bin   -skip-semantic -skip-index                (adds Binary)
  sem   -skip-binary -skip-index                  (adds Semantic)
  full  (no skips)                                (all five stages)

JSON output schema (SCHEMA_VERSION 1):
  {
    "schema_version": 1,
    "script_version": 2,
    "context": { ... environment, fixture, git, hardware ... },
    "configs": {
      "min":  { "raw": {...}, "derived": {...}, "warnings": [...] },
      "idx":  { ... },
      "bin":  { ... },
      "sem":  { ... },
      "full": { ... }
    },
    "deltas": {
      "index_vs_struct":   { ... },
      "binary_vs_struct":  { ... },
      "semantic_vs_struct":{ ... }
    },
    "breakdown": {
      "wall_time_pct": { "struct": ..., "index": ..., ... },
      "rss_pct":       { "struct": ..., "index": ..., ... }
    },
    "gates":   [ { "config": "min", "metric": "throughput_mib_s", ... } ],
    "config_order": ["min", "idx", "bin", "sem", "full"]
  }

Gates file format (--gates):
  [
    {
      "config": "min",
      "metric": "throughput_mib_s",
      "op": "min",
      "value": 98.0,
      "label": "L0 struct min throughput"
    },
    {
      "config": "full",
      "metric": "wall_time_s",
      "op": "max",
      "value": 15.0,
      "label": "L2 astral wall-time ceiling"
    }
  ]

  Supported metrics: throughput_mib_s, wall_time_s, wall_time_ms, peak_rss_mib,
                     ipc, cache_miss_pct, branch_miss_pct, rss_pct_of_file.
  Supported ops: min (actual >= value is pass), max (actual <= value is pass).

Dependencies: zebrac, jq, awk, git (optional), /proc (Linux).
USAGE_EOF

    if [[ "$out_fd" == "stdout" ]]; then
        exit 0
    else
        exit 1
    fi
}

version() {
    echo "bench-profile v${SCRIPT_VERSION} (schema ${SCHEMA_VERSION})"
    exit 0
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

die() {
    local code="${2:-1}"
    echo "Error: $*" >&2
    exit "$code"
}

warn() {
    echo "Warn: $*" >&2
}

info() {
    if [[ "$VERBOSE" -eq 1 ]]; then
        echo "Info: $*" >&2
    fi
}

require_arg() {
    local flag="$1"
    local value="${2:-}"
    if [[ -z "$value" || "$value" == --* ]]; then
        die "flag $flag requires a value"
    fi
}

parse_float() {
    local value="$1"
    local name="$2"
    if ! [[ "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        die "$name must be a non-negative number, got: $value"
    fi
    echo "$value"
}

parse_args() {
    if [[ $# -eq 0 ]]; then
        # No args: usage on stderr, exit 1
        usage stderr
    fi

    case "${1:-}" in
        --help|-h) usage stdout ;;
        --version) version ;;
    esac

    if [[ "${1:-}" == "--compare" ]]; then
        MODE="compare"
        COMPARE_OLD="${2:-}"
        COMPARE_NEW="${3:-}"
        [[ -z "$COMPARE_OLD" || -z "$COMPARE_NEW" ]] && \
            die "--compare requires <old.json> <new.json>"
        shift 3
    fi

    # Two-pass parse: first pass extracts any bench-profile options that
    # appear anywhere in the arg list (including after fixtures). The
    # remaining positional args are fixtures; the rest of the zebrac-style
    # flags (-d, -i, -a, -w, -f, -q, etc.) are forwarded to zebrac.
    #
    # Single-letter zebrac flags are recognized so their value tokens
    # are kept together with the flag and not misread as fixtures.
    local -a bench_opts=()
    local -a passthrough=()
    local -a positionals=()
    local i=0
    local args=("$@")
    while [[ $i -lt $# ]]; do
        local a="${args[$i]}"
        case "$a" in
            --json|--gates|--cv-threshold|--regression-pct|--rss-regression-pct|--ipc-regression-pct|--seed|--timeout)
                [[ $((i + 1)) -ge $# ]] && die "$a requires a value"
                bench_opts+=("$a" "${args[$((i + 1))]}")
                i=$((i + 2))
                ;;
            --randomize|--no-randomize|--drop-caches|--quiet|--verbose)
                bench_opts+=("$a")
                i=$((i + 1))
                ;;
            -d|-i|-a|-w|--color)
                # Zebrac single-letter flags that take a value.
                [[ $((i + 1)) -ge $# ]] && die "$a requires a value"
                passthrough+=("$a" "${args[$((i + 1))]}")
                i=$((i + 2))
                ;;
            -f|-q)
                # Zebrac single-letter boolean flags.
                passthrough+=("$a")
                i=$((i + 1))
                ;;
            --)
                # Explicit end of options. Everything after is positional
                # (fixtures), no zebrac flags allowed after this.
                for ((j = i + 1; j < $#; j++)); do
                    positionals+=("${args[$j]}")
                done
                i=$#
                ;;
            -*)
                # Unknown single-dash flag: pass through. May be zebrac or
                # a typo; zebrac will report the typo itself.
                passthrough+=("$a")
                i=$((i + 1))
                ;;
            *)
                positionals+=("$a")
                i=$((i + 1))
                ;;
        esac
    done

    # Re-parse bench_opts into the option variables.
    i=0
    while [[ $i -lt ${#bench_opts[@]} ]]; do
        case "${bench_opts[$i]}" in
            --json)              JSON_DIR="${bench_opts[$((i+1))]}";              i=$((i+2)) ;;
            --gates)             GATES_FILE="${bench_opts[$((i+1))]}";            i=$((i+2)) ;;
            --cv-threshold)      CV_THRESHOLD=$(parse_float "${bench_opts[$((i+1))]}" "cv-threshold");      i=$((i+2)) ;;
            --regression-pct)    WALL_REGRESSION_PCT=$(parse_float "${bench_opts[$((i+1))]}" "regression-pct"); i=$((i+2)) ;;
            --rss-regression-pct) RSS_REGRESSION_PCT=$(parse_float "${bench_opts[$((i+1))]}" "rss-regression-pct"); i=$((i+2)) ;;
            --ipc-regression-pct) IPC_REGRESSION_PCT=$(parse_float "${bench_opts[$((i+1))]}" "ipc-regression-pct"); i=$((i+2)) ;;
            --seed)              RANDOM_SEED="${bench_opts[$((i+1))]}";           i=$((i+2)) ;;
            --timeout)           TIMEOUT_SECONDS="${bench_opts[$((i+1))]}";       i=$((i+2)) ;;
            --randomize)         RANDOMIZE=1; i=$((i+1)) ;;
            --no-randomize)      RANDOMIZE=0; i=$((i+1)) ;;
            --drop-caches)       DROP_CACHES=1; i=$((i+1)) ;;
            --quiet)             VERBOSE=0; i=$((i+1)) ;;
            --verbose)           VERBOSE=1; i=$((i+1)) ;;
            *) die "internal: unhandled bench opt ${bench_opts[$i]}" ;;
        esac
    done

    # Single-letter flags that take values (e.g. -d 500). These need a
    # value-following-token pass. We split the passthrough array into
    # flag/value pairs and then forward them to zebrac.
    ZEBRAC_FLAGS=("${passthrough[@]+"${passthrough[@]}"}")
    FIXTURES=("${positionals[@]+"${positionals[@]}"}")

    if [[ "$MODE" == "profile" ]]; then
        [[ ${#FIXTURES[@]} -eq 0 ]] && die "at least one fixture is required"
    fi

    if [[ -n "$RANDOM_SEED" ]]; then
        RANDOM=$RANDOM_SEED
    fi
}

# ---------------------------------------------------------------------------
# Prerequisite checks
# ---------------------------------------------------------------------------

check_prereqs() {
    [[ -x "$ZEBRAC" ]] || die "zebrac not found at $ZEBRAC"
    command -v jq &>/dev/null || die "jq is required but not installed"
    command -v awk &>/dev/null || die "awk is required but not installed"

    if [[ "$MODE" == "profile" ]]; then
        [[ -x "$MZVALIDATE" ]] || die "mzValidate binary not found at $MZVALIDATE. Build with: zig build -Doptimize=ReleaseFast"
        for f in "${FIXTURES[@]}"; do
            [[ -f "$f" ]] || die "fixture not found: $f"
        done
    fi

    if [[ "$MODE" == "compare" ]]; then
        [[ -f "$COMPARE_OLD" ]] || die "old JSON not found: $COMPARE_OLD"
        [[ -f "$COMPARE_NEW" ]] || die "new JSON not found: $COMPARE_NEW"
    fi

    if [[ -n "$GATES_FILE" ]]; then
        [[ -f "$GATES_FILE" ]] || die "gates file not found: $GATES_FILE"
    fi

    if [[ "$DROP_CACHES" -eq 1 ]] && [[ ! -w /proc/sys/vm/drop_caches ]]; then
        warn "--drop-caches requested but /proc/sys/vm/drop_caches is not writable; falling back to no drop"
        DROP_CACHES=0
    fi
}

# ---------------------------------------------------------------------------
# System / git / environment context
# ---------------------------------------------------------------------------

timestamp_iso() {
    date -u +"%Y-%m-%dT%H:%M:%SZ"
}

get_hostname() {
    hostname 2>/dev/null || echo "unknown"
}

# CPU model from /proc/cpuinfo. Reads only the first match.
get_cpu_model() {
    awk -F': ' '/model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null \
        | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
        || echo "unknown"
}

# Number of logical CPUs available to this process.
get_cpu_cores() {
    nproc 2>/dev/null || awk '/^processor/ {c++} END {print c+0}' /proc/cpuinfo
}

# RAM in MiB.
get_ram_mib() {
    awk '/^MemTotal:/ {printf "%d\n", $2/1024}' /proc/meminfo 2>/dev/null \
        || echo "0"
}

get_kernel() {
    uname -r 2>/dev/null || echo "unknown"
}

# CPU governor of cpu0 (typical signal for throttling).
get_cpu_governor() {
    cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null \
        || echo "unknown"
}

# Frequency scaling range. Format: "<min>-<max> <unit>".
get_cpu_freq() {
    local min max
    min=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 2>/dev/null || echo 0)
    max=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || echo 0)
    if [[ "$min" == "0" || "$max" == "0" ]]; then
        echo "unknown"
    else
        printf "%d-%d kHz" "$min" "$max"
    fi
}

get_git_rev() {
    git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo "unknown"
}

get_git_branch() {
    git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown"
}

# True if working tree has uncommitted changes.
get_git_dirty() {
    if [[ -n "$(git -C "$REPO_ROOT" status --porcelain 2>/dev/null)" ]]; then
        echo "true"
    else
        echo "false"
    fi
}

# Try to get zebrac version. Falls back to "unknown" if zebrac does not
# implement --version.
get_zebrac_version() {
    "$ZEBRAC" --version 2>/dev/null | head -n1 || echo "unknown"
}

# ---------------------------------------------------------------------------
# Numeric helpers (awk)
# ---------------------------------------------------------------------------

# Compute a single awk expression to 6 decimal places.
calc() {
    awk "BEGIN { printf \"%.6f\", $1 }"
}

# Format a number to N decimal places.
format_dec() {
    local val="$1"
    local places="${2:-1}"
    awk -v v="$val" -v p="$places" 'BEGIN { printf "%.*f", p, v+0 }'
}

# Float comparison: returns 0 if $1 > $2, 1 otherwise. Used for thresholds.
float_gt() {
    awk -v a="$1" -v b="$2" 'BEGIN { exit !(a+0 > b+0) }'
}

# ---------------------------------------------------------------------------
# Config order randomization
# ---------------------------------------------------------------------------

# Fisher-Yates shuffle, seeded from $RANDOM. Output is one config per line.
# Always preserves JSON emission in canonical order (CONFIG_KEYS); this
# affects only execution order.
shuffle_configs() {
    local -a arr=("${CONFIG_KEYS[@]}")
    local n=${#arr[@]}
    local i j tmp
    for ((i = n - 1; i > 0; i--)); do
        j=$((RANDOM % (i + 1)))
        tmp=${arr[$i]}
        arr[$i]=${arr[$j]}
        arr[$j]=$tmp
    done
    printf '%s\n' "${arr[@]}"
}

# ---------------------------------------------------------------------------
# Cache control
# ---------------------------------------------------------------------------

drop_caches() {
    if [[ "$DROP_CACHES" -ne 1 ]]; then
        return 0
    fi
    sync
    if ! echo 3 > /proc/sys/vm/drop_caches 2>/dev/null; then
        warn "drop_caches failed (permission)"
        return 1
    fi
    # Second sync: ensures the first sync's writeback is complete and any
    # async page reclaim kicked off by drop_caches has settled. Without
    # this, the first zebrac config may still compete with the reclaimer.
    sync
    # Short sleep to allow the kernel to finish reclaiming before the
    # first perf sampling starts. A profiling run is minutes long, so
    # 200 ms of startup latency is negligible.
    sleep 0.2
    info "page cache dropped"
}

# ---------------------------------------------------------------------------
# Metric extraction
# ---------------------------------------------------------------------------

# Extract a single metric struct from zebrac JSON. Writes mean, stddev,
# min, max, median, q1, q3, outlier_count, sample_count, unit to stdout
# as a single jq-emitted JSON object, or {"missing": true, "field": ...}
# if the field is absent.
extract_metric_obj() {
    local json_file="$1"
    local metric="$2"
    jq -e --arg m "$metric" '.results[0][$m] // null' "$json_file" 2>/dev/null \
        | jq 'if type == "object" then . else {missing: true, field: $m} end' \
            --arg m "$metric"
}

# Extract all metrics at once. Produces a single JSON object containing every
# metric for one zebrac run. Missing fields are preserved as nulls, then
# the caller decides how to handle.
extract_all_metrics() {
    local json_file="$1"
    jq '
        .results[0] as $r |
        {
            wall_time:        ($r.wall_time // null),
            peak_rss:         ($r.peak_rss // null),
            cpu_cycles:       ($r.cpu_cycles // null),
            instructions:     ($r.instructions // null),
            cache_references: ($r.cache_references // null),
            cache_misses:     ($r.cache_misses // null),
            branch_misses:    ($r.branch_misses // null),
            sample_count:     ($r.wall_time.sample_count // null)
        }
    ' "$json_file"
}

# ---------------------------------------------------------------------------
# Derived metric computation (awk)
# ---------------------------------------------------------------------------

# Computes derived metrics from a single config's raw data.
# Args: wall_ns, wall_stddev_ns, rss_bytes, cycles, insns,
#       cache_ref, cache_miss, branch_miss, file_size_bytes
# Output: 11 space-separated fields (in order):
#   wall_ms, wall_s, throughput_mib_s, rss_mib, rss_pct,
#   cycles_m, insns_m, ipc, cache_miss_pct, branch_miss_pct, cv_pct
compute_derived_awk() {
    awk -v w="$1" -v ws="$2" -v r="$3" -v c="$4" -v i="$5" \
        -v cr="$6" -v cm="$7" -v bm="$8" -v fs="$9" '
    BEGIN {
        w_ms  = w  / 1e6
        w_s   = w  / 1e9
        mibs  = (w_s > 0) ? fs / w_s / 1048576 : 0
        r_mib = r  / 1048576
        r_pct = (fs > 0) ? r / fs * 100 : 0
        c_m   = c  / 1e6
        i_m   = i  / 1e6
        ipc   = (c > 0) ? i / c : 0
        c_pct = (cr > 0) ? cm / cr * 100 : 0
        b_pct = (i > 0) ? bm / i * 100 : 0
        cv    = (w > 0) ? ws / w * 100 : 0
        printf "%.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f %.6f\n", \
            w_ms, w_s, mibs, r_mib, r_pct, c_m, i_m, ipc, c_pct, b_pct, cv
    }'
}

# Computes delta metrics from struct baseline and stage metrics.
# Args: base_wall_ms, base_rss_mib, base_cycles_m, base_insns_m, base_mib_s,
#       wall_ms, rss_mib, cycles_m, insns_m, file_size_bytes
# Output: 6 space-separated fields:
#   delta_wall_ms, delta_mib_s, delta_rss_pct, delta_rss_mib,
#   delta_cycles_m, delta_insns_m
compute_delta_awk() {
    awk -v bwm="$1" -v brm="$2" -v bcm="$3" -v bim="$4" -v bmib="$5" \
        -v wm="$6" -v rm="$7" -v cm="$8" -v im="$9" -v fs="${10}" \
        -v w_base_s="$(awk -v x="$1" 'BEGIN{print x/1000}')" \
        -v w_stage_s="$(awk -v x="$6" 'BEGIN{print x/1000}')" '
    BEGIN {
        d_wm  = wm - bwm
        bmib_now = (w_stage_s > 0) ? fs / w_stage_s / 1048576 : 0
        bmib_base = (w_base_s  > 0) ? fs / w_base_s  / 1048576 : 0
        d_mib = bmib_now - bmib_base
        d_rp  = (fs > 0) ? (rm - brm) / fs * 100 * 1048576 : 0
        d_rm  = rm - brm
        d_cm  = cm - bcm
        d_im  = im - bim
        printf "%.6f %.6f %.6f %.6f %.6f %.6f\n", d_wm, d_mib, d_rp, d_rm, d_cm, d_im
    }'
}

# ---------------------------------------------------------------------------
# Statistical helpers for compare mode
# ---------------------------------------------------------------------------

# Compute Welch's z-approximation, Cohen's d, and minimum detectable effect.
# For large n (typical: 5 outer * 3 inner = 15), Welch's t converges to
# z, so we use the normal approximation. This avoids needing t-distribution
# critical values in awk.
# Args: mean_a, stddev_a, n_a, mean_b, stddev_b, n_b
# Output: 4 fields: z, p_bucket, cohen_d, mde
#   p_bucket is 0 (n.s.), 1 (p<0.10), 2 (p<0.05), 3 (p<0.01), 4 (p<0.001)
compute_stats_awk() {
    awk -v m1="$1" -v s1="$2" -v n1="$3" -v m2="$4" -v s2="$5" -v n2="$6" '
    function fabs(x) { return x < 0 ? -x : x }
    function ssqrt(x) { return x < 0 ? 0 : x^0.5 }
    BEGIN {
        if (n1 <= 0 || n2 <= 0) { printf "0 0 0 0\n"; exit }
        se = ssqrt(s1*s1/n1 + s2*s2/n2)
        if (se == 0) { printf "0 0 0 0\n"; exit }
        z = (m2 - m1) / se
        az = fabs(z)

        # Bucket the two-tailed p-value.
        if      (az < 1.645) pb = 0
        else if (az < 1.960) pb = 1
        else if (az < 2.576) pb = 2
        else if (az < 3.291) pb = 3
        else                 pb = 4

        # Cohen d with pooled stddev. Guard against n1+n2-2 == 0 (sample
        # size 1 for both groups). Use ssqrt(s1*s1 + s2*s2) / 2 as a
        # rough pooled estimate when df = 0; if that is also zero, d = 0.
        df = n1 + n2 - 2
        if (df > 0) {
            sp = ssqrt(((n1-1)*s1*s1 + (n2-1)*s2*s2) / df)
        } else {
            sp = ssqrt((s1*s1 + s2*s2) / 2)
        }
        if (sp == 0) d = 0
        else d = (m2 - m1) / sp

        # MDE at p<0.05 (z=1.96) for this sample size.
        mde = 1.96 * se

        printf "%.6f %d %.6f %.6f\n", z, pb, d, mde
    }'
}

# Map p_bucket integer to a label.
p_bucket_label() {
    case "$1" in
        0) echo "n.s." ;;
        1) echo "p<0.10" ;;
        2) echo "p<0.05" ;;
        3) echo "p<0.01" ;;
        4) echo "p<0.001" ;;
        *) echo "?" ;;
    esac
}

